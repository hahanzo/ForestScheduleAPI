<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="lessons">Лісотех (Розклад)</a>
    </div>
</div>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="lessons">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Розклад занять
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="lessons/create">
                <span class="oi oi-plus" aria-hidden="true"></span> Додати пару
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-5">
            <button class="nav-link btn btn-link text-danger" @onclick="Logout">
                <span class="oi oi-account-logout" aria-hidden="true"></span> Вийти
            </button>
        </div>
    </nav>
</div>

@code {
    [Inject] private Microsoft.JSInterop.IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        Nav.NavigateTo("/", true);
    }
}